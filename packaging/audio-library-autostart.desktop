[Desktop Entry]
Type=Application
Name=Audio Library
GenericName=Audio Player
Comment=Start Audio Library in the background (tray only)
Exec=env AUDIO_LIBRARY_BACKGROUND=1 audio-library
Icon=audio-library
Terminal=false
Categories=AudioVideo;Audio;Music;Player;
Keywords=music;audio;play;
StartupNotify=false
X-GNOME-Autostart-enabled=true
